# ============================================================
# ENVIRONMENT VARIABLES — Sistem Presensi DPRD Surakarta
#
# Salin file ini ke .env dan isi dengan nilai yang sesuai
# JANGAN pernah commit file .env ke version control (git)
# ============================================================

# --- Database ---
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://dprd_user:GANTI_PASSWORD_KUAT@localhost:5432/absensi_dprd

# --- Security ---
# Generate dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_DENGAN_RANDOM_64_HEX_CHARS

# Generate Fernet key dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMBEDDING_ENCRYPTION_KEY=GANTI_DENGAN_FERNET_KEY

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Face Recognition ---
SIMILARITY_THRESHOLD=0.50
DUPLICATE_ENROLLMENT_THRESHOLD=0.70
LIVENESS_THRESHOLD=0.80
ATTENDANCE_COOLDOWN_MINUTES=5
MAX_FACE_FAIL_BEFORE_FALLBACK=5

INSIGHTFACE_MODEL=buffalo_sc
FACE_DET_SIZE=320

# --- Storage ---
EVIDENCE_PHOTO_PATH=./data/evidence_photos
ENROLLMENT_TEMP_PATH=./data/enrollment_temp
EVIDENCE_RETENTION_DAYS=90

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# IP/origin tablet kiosk yang diizinkan akses (pisah dengan koma jika lebih dari satu)
# Gunakan HTTPS di produksi
ALLOWED_ORIGINS=https://192.168.1.20,http://localhost:3000

# --- Kiosk Security ---
# Set true di produksi — tablet harus punya device_token yang valid
DEVICE_AUTH_ENABLED=true

# --- Jam Kerja (untuk flagging presensi di luar jam kerja) ---
WORK_START_HOUR=7
WORK_END_HOUR=17
